<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cat Clicker Deluxe - Infinite Feline Empire</title>
    <style>
        :root {
            --bg-primary: #fce4ec;
            --bg-secondary: #f8bbd0;
            --accent-main: #ec407a;
            --accent-hover: #d81b60;
            --card-bg: rgba(255, 255, 255, 0.85);
            --text-dark: #2c3e50;
            --text-light: #7f8c8d;
            --gold: #f39c12;
            --purple: #9b59b6;
            --blue: #3498db;
            --green: #2ecc71;
            --shadow: 0 12px 32px rgba(236, 64, 122, 0.12);
            --border-radius: 20px;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
            background: linear-gradient(135deg, var(--bg-primary), var(--bg-secondary));
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        header {
            background-color: var(--card-bg);
            padding: 16px 36px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo-title {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 26px;
            font-weight: 900;
            color: var(--accent-main);
        }

        .nav-tabs {
            display: flex;
            gap: 12px;
        }

        .tab-btn {
            background: transparent;
            border: 2px solid var(--accent-main);
            color: var(--accent-main);
            padding: 9px 20px;
            border-radius: 25px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--accent-main);
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(236, 64, 122, 0.3);
            transform: translateY(-2px);
        }

        .app-container {
            display: grid;
            grid-template-columns: 360px 1fr 380px;
            gap: 28px;
            padding: 28px;
            max-width: 1650px;
            margin: 0 auto;
            width: 100%;
            flex: 1;
        }

        .panel {
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: var(--shadow);
            display: flex;
            flex-direction: column;
            gap: 18px;
            max-height: calc(100vh - 140px);
            overflow-y: auto;
        }

        .panel-title {
            font-size: 19px;
            font-weight: 800;
            border-bottom: 2px solid rgba(0, 0, 0, 0.05);
            padding-bottom: 12px;
            margin: 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .clicker-section {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            background: var(--card-bg);
            border-radius: var(--border-radius);
            padding: 30px;
            box-shadow: var(--shadow);
        }

        .score-board {
            text-align: center;
            margin-bottom: 25px;
            background: rgba(255, 255, 255, 0.4);
            padding: 16px 30px;
            border-radius: 16px;
            width: 100%;
            max-width: 400px;
        }

        .pat-counter {
            font-size: 52px;
            font-weight: 900;
            color: var(--accent-main);
            margin: 0;
        }

        .pps-counter {
            font-size: 15px;
            color: var(--text-light);
            margin-top: 6px;
            font-weight: 600;
        }

        .cat-stage {
            position: relative;
            width: 300px;
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .cat-button {
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: radial-gradient(circle, #ffffff 0%, var(--bg-primary) 100%);
            border: 8px solid var(--accent-main);
            cursor: pointer;
            outline: none;
            font-size: 130px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 15px 35px rgba(236, 64, 122, 0.35);
            transition: transform 0.08s ease;
            position: relative;
            z-index: 10;
        }

        .cat-button:active {
            transform: scale(0.90) rotate(-4deg);
        }

        .click-particle {
            position: absolute;
            font-weight: 900;
            font-size: 26px;
            color: var(--accent-main);
            pointer-events: none;
            animation: floatAndFade 0.9s forwards ease-out;
            z-index: 50;
        }

        @keyframes floatAndFade {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(0.8) translateY(0); }
            50% { transform: translate(-50%, -50%) scale(1.3) translateY(-45px); }
            100% { opacity: 0; transform: translate(-50%, -50%) scale(1) translateY(-90px); }
        }

        .upgrade-card {
            background: rgba(255, 255, 255, 0.6);
            border-radius: 14px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            cursor: pointer;
            transition: all 0.25s ease;
            border: 2px solid transparent;
        }

        .upgrade-card:hover:not(.disabled) {
            transform: translateY(-3px);
            border-color: var(--accent-main);
            background: rgba(255, 255, 255, 0.95);
        }

        .upgrade-card.disabled {
            opacity: 0.45;
            cursor: not-allowed;
            filter: grayscale(0.7);
        }

        .upgrade-icon {
            font-size: 34px;
            width: 52px;
            height: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--card-bg);
            border-radius: 12px;
        }

        .upgrade-details { flex: 1; }
        .upgrade-name { font-weight: 800; font-size: 15px; margin: 0 0 3px 0; }
        .upgrade-effect { font-size: 12px; color: var(--text-light); margin: 0 0 4px 0; font-weight: 500; }
        .upgrade-cost { font-weight: 800; color: var(--accent-main); font-size: 13px; }
        .upgrade-count { font-size: 20px; font-weight: 900; color: var(--text-light); opacity: 0.8; }

        .achievements-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(75px, 1fr));
            gap: 14px;
        }

        .achievement-badge {
            aspect-ratio: 1;
            background: rgba(0, 0, 0, 0.03);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            opacity: 0.35;
            filter: grayscale(1);
            border: 2px dashed var(--text-light);
        }

        .achievement-badge.unlocked {
            opacity: 1;
            filter: grayscale(0);
            border: 2px solid var(--gold);
            background: #fffde7;
        }

        .toast-container {
            position: fixed;
            bottom: 25px;
            right: 25px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 1000;
        }

        .toast {
            background: var(--card-bg);
            border-left: 6px solid var(--gold);
            padding: 16px 22px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.18);
            display: flex;
            align-items: center;
            gap: 14px;
            font-weight: 700;
            font-size: 14px;
        }

        .btn-action {
            background: var(--accent-main);
            color: white;
            border: none;
            padding: 11px 20px;
            border-radius: 12px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .btn-action:hover { background: var(--accent-hover); }
        .btn-danger { background: #e74c3c; }
        .btn-danger:hover { background: #c0392b; }
        .btn-gold { background: var(--gold); }
        .btn-gold:hover { background: #d35400; }

        .stats-list { display: flex; flex-direction: column; gap: 12px; }
        .stat-row { display: flex; justify-content: space-between; padding: 10px 0; border-bottom: 1px solid rgba(0,0,0,0.05); font-weight: 600; }

        @media (max-width: 1200px) {
            .app-container { grid-template-columns: 1fr; max-width: 700px; }
            .panel { max-height: none; }
        }
    </style>
</head>
<body>

    <header>
        <div class="logo-title">
            <span>🐱</span>
            <span>Cat Clicker Deluxe</span>
        </div>
        <div class="nav-tabs">
            <button class="tab-btn active" onclick="switchTab('game', event)">Game</button>
            <button class="tab-btn" onclick="switchTab('stats', event)">Stats & Codex</button>
            <button class="tab-btn" onclick="switchTab('prestige', event)">Reincarnate</button>
            <button class="tab-btn" onclick="switchTab('settings', event)">Settings</button>
        </div>
    </header>

    <div class="app-container" id="game-tab">
        <div class="panel">
            <h3 class="panel-title">
                <span>Click Upgrades</span>
                <span id="click-power-display">Power: 1</span>
            </h3>
            <div id="click-upgrades-list"></div>
        </div>

        <div class="panel clicker-section">
            <div class="score-board">
                <div class="pat-counter" id="pat-count">0</div>
                <div class="pps-counter">Pats per second: <span id="pps-count">0.0</span></div>
                <div class="pps-counter" style="color: var(--gold); font-weight: 700;">Golden Paw Multiplier: <span id="prestige-mult">1.0x</span></div>
            </div>

            <div class="cat-stage">
                <button class="cat-button" id="cat-btn">🐱</button>
            </div>

            <div style="display: flex; gap: 10px; margin-top: 30px;">
                <button class="btn-action" onclick="audioEngine.playSound('meow')">🔊 Meow</button>
            </div>
        </div>

        <div class="panel">
            <h3 class="panel-title">
                <span>Passive Empire</span>
                <span>Buildings</span>
            </h3>
            <div id="passive-upgrades-list"></div>
        </div>
    </div>

    <div class="app-container" id="stats-tab" style="display: none;">
        <div class="panel">
            <h3 class="panel-title">Statistics</h3>
            <div class="stats-list">
                <div class="stat-row"><span>Total Pats Earned:</span><span id="stat-total-pats">0</span></div>
                <div class="stat-row"><span>Manual Clicks:</span><span id="stat-clicks">0</span></div>
                <div class="stat-row"><span>Time Played:</span><span id="stat-time">0s</span></div>
                <div class="stat-row"><span>Reincarnations:</span><span id="stat-prestige">0</span></div>
            </div>
        </div>
        <div class="panel" style="grid-column: span 2;">
            <h3 class="panel-title">Achievements</h3>
            <div class="achievements-grid" id="achievements-list"></div>
        </div>
    </div>

    <div class="app-container" id="prestige-tab" style="display: none;">
        <div class="panel" style="grid-column: span 3; text-align: center;">
            <h2 style="color: var(--gold);">🐾 Golden Paw Reincarnation 🐾</h2>
            <p>Ascend your cat empire! Resets pats and buildings to earn Golden Paws that permanently boost production.</p>
            <h3 style="font-size: 32px; color: var(--gold); margin: 20px 0;">
                Pending Golden Paws: +<span id="pending-paws">0</span>
            </h3>
            <button class="btn-action btn-gold" style="font-size: 20px; padding: 15px 40px;" onclick="doPrestige()">Reincarnate Now!</button>
        </div>
    </div>

    <div class="app-container" id="settings-tab" style="display: none;">
        <div class="panel" style="grid-column: span 3;">
            <h3 class="panel-title">Game Settings</h3>
            <div style="display: flex; gap: 15px; margin-top: 15px;">
                <button class="btn-action" onclick="saveGame(true)">💾 Save Game</button>
                <button class="btn-action btn-danger" onclick="hardReset()">⚠️ Reset All Progress</button>
            </div>
        </div>
    </div>

    <div class="toast-container" id="toast-container"></div>

    <script>
        class AudioEngine {
            constructor() { this.ctx = null; this.enabled = true; }
            init() { if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }
            playSound(type) {
                if (!this.enabled) return;
                this.init();
                const osc = this.ctx.createOscillator();
                const gain = this.ctx.createGain();
                osc.connect(gain);
                gain.connect(this.ctx.destination);
                const now = this.ctx.currentTime;

                if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(420, now);
                    osc.frequency.exponentialRampToValueAtTime(840, now + 0.06);
                    gain.gain.setValueAtTime(0.2, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.06);
                    osc.start(now); osc.stop(now + 0.06);
                } else if (type === 'meow') {
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(280, now);
                    osc.frequency.exponentialRampToValueAtTime(620, now + 0.15);
                    gain.gain.setValueAtTime(0.25, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
                    osc.start(now); osc.stop(now + 0.35);
                } else if (type === 'buy') {
                    osc.type = 'square';
                    osc.frequency.setValueAtTime(523.25, now);
                    osc.frequency.setValueAtTime(659.25, now + 0.08);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.22);
                    osc.start(now); osc.stop(now + 0.22);
                }
            }
        }

        const audioEngine = new AudioEngine();

        let state = {
            pats: 0, totalPats: 0, manualClicks: 0, timePlayed: 0,
            prestigeCount: 0, goldenPaws: 0, upgrades: {}, achievements: {}
        };

        const clickUpgrades = [
            { id: 'c1', name: 'Soft Glove', cost: 15, power: 1, icon: '🧤' },
            { id: 'c2', name: 'Catnip Finger', cost: 100, power: 5, icon: '🌿' },
            { id: 'c3', name: 'Brush of Destiny', cost: 1100, power: 25, icon: '🧹' },
            { id: 'c4', name: 'Laser Pointer', cost: 12000, power: 120, icon: '🔦' }
        ];

        const passiveUpgrades = [
            { id: 'p1', name: 'Stray Friend', cost: 15, pps: 0.5, icon: '🐈' },
            { id: 'p2', name: 'Cat Treat Box', cost: 100, pps: 4, icon: '🐟' },
            { id: 'p3', name: 'Scratching Post', cost: 1100, pps: 32, icon: '🪵' },
            { id: 'p4', name: 'Catnip Garden', cost: 12000, pps: 260, icon: '🌱' }
        ];

        const achievements = [
            { id: 'a1', name: 'First Scratch', desc: 'Click the cat 1 time.', icon: '🐾', req: () => state.manualClicks >= 1 },
            { id: 'a2', name: 'Feline Enthusiast', desc: 'Reach 1,000 total pats.', icon: '😸', req: () => state.totalPats >= 1000 }
        ];

        function getPrestigeMultiplier() { return 1 + (state.goldenPaws * 0.1); }
        function calculatePPS() {
            let pps = 0;
            passiveUpgrades.forEach(u => { pps += (state.upgrades[u.id] || 0) * u.pps; });
            return pps * getPrestigeMultiplier();
        }
        function calculateClickPower() {
            let power = 1;
            clickUpgrades.forEach(u => { power += (state.upgrades[u.id] || 0) * u.power; });
            return power * getPrestigeMultiplier();
        }

        const catBtn = document.getElementById('cat-btn');
        if (catBtn) {
            catBtn.addEventListener('click', (e) => {
                const power = calculateClickPower();
                state.pats += power;
                state.totalPats += power;
                state.manualClicks++;
                audioEngine.playSound('click');
                createParticle(e.clientX, e.clientY, `+${formatNumber(power)}`);
                updateDisplay();
                checkAchievements();
            });
        }

        function createParticle(x, y, text) {
            const el = document.createElement('div');
            el.className = 'click-particle';
            el.innerText = text;
            el.style.left = `${x}px`;
            el.style.top = `${y}px`;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 900);
        }

        function buyUpgrade(id, type) {
            const list = type === 'click' ? clickUpgrades : passiveUpgrades;
            const item = list.find(u => u.id === id);
            const count = state.upgrades[id] || 0;
            const cost = Math.floor(item.cost * Math.pow(1.15, count));
            if (state.pats >= cost) {
                state.pats -= cost;
                state.upgrades[id] = count + 1;
                audioEngine.playSound('buy');
                updateDisplay();
                renderShops();
            }
        }

        function renderShops() {
            const clickContainer = document.getElementById('click-upgrades-list');
            if (clickContainer) {
                clickContainer.innerHTML = '';
                clickUpgrades.forEach(u => {
                    const count = state.upgrades[u.id] || 0;
                    const cost = Math.floor(u.cost * Math.pow(1.15, count));
                    const disabled = state.pats < cost ? 'disabled' : '';
                    clickContainer.innerHTML += `
                        <div class="upgrade-card ${disabled}" onclick="buyUpgrade('${u.id}', 'click')">
                            <div class="upgrade-icon">${u.icon}</div>
                            <div class="upgrade-details">
                                <div class="upgrade-name">${u.name}</div>
                                <div class="upgrade-effect">+${u.power} per click</div>
                                <div class="upgrade-cost">${formatNumber(cost)} pats</div>
                            </div>
                            <div class="upgrade-count">${count}</div>
                        </div>`;
                });
            }

            const passiveContainer = document.getElementById('passive-upgrades-list');
            if (passiveContainer) {
                passiveContainer.innerHTML = '';
                passiveUpgrades.forEach(u => {
                    const count = state.upgrades[u.id] || 0;
                    const cost = Math.floor(u.cost * Math.pow(1.15, count));
                    const disabled = state.pats < cost ? 'disabled' : '';
                    passiveContainer.innerHTML += `
                        <div class="upgrade-card ${disabled}" onclick="buyUpgrade('${u.id}', 'passive')">
                            <div class="upgrade-icon">${u.icon}</div>
                            <div class="upgrade-details">
                                <div class="upgrade-name">${u.name}</div>
                                <div class="upgrade-effect">+${u.pps} pat/sec</div>
                                <div class="upgrade-cost">${formatNumber(cost)} pats</div>
                            </div>
                            <div class="upgrade-count">${count}</div>
                        </div>`;
                });
            }
        }

        function renderAchievements() {
            const container = document.getElementById('achievements-list');
            if (container) {
                container.innerHTML = '';
                achievements.forEach(a => {
                    const unlocked = state.achievements[a.id] ? 'unlocked' : '';
                    container.innerHTML += `<div class="achievement-badge ${unlocked}" title="${a.name}">${a.icon}</div>`;
                });
            }
        }

        function updateDisplay() {
            document.getElementById('pat-count').innerText = formatNumber(Math.floor(state.pats));
            document.getElementById('pps-count').innerText = formatNumber(calculatePPS().toFixed(1));
            document.getElementById('click-power-display').innerText = `Power: ${formatNumber(calculateClickPower())}`;
            document.getElementById('prestige-mult').innerText = `${getPrestigeMultiplier().toFixed(1)}x`;

            document.getElementById('stat-total-pats').innerText = formatNumber(Math.floor(state.totalPats));
            document.getElementById('stat-clicks').innerText = formatNumber(state.manualClicks);
            document.getElementById('stat-time').innerText = `${Math.floor(state.timePlayed)}s`;
            document.getElementById('stat-prestige').innerText = state.prestigeCount;
            document.getElementById('pending-paws').innerText = Math.floor(Math.sqrt(state.totalPats / 1000000));

            renderShops();
        }

        setInterval(() => {
            const pps = calculatePPS();
            state.pats += pps / 10;
            state.totalPats += pps / 10;
            state.timePlayed += 0.1;
            updateDisplay();
            checkAchievements();
        }, 100);

        setInterval(() => saveGame(false), 30000);

        function checkAchievements() {
            achievements.forEach(a => {
                if (!state.achievements[a.id] && a.req()) {
                    state.achievements[a.id] = true;
                    showToast(`Achievement Unlocked: ${a.name}!`, a.icon);
                    renderAchievements();
                }
            });
        }

        function showToast(text, icon = '🏆') {
            const container = document.getElementById('toast-container');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'toast';
            toast.innerHTML = `<span style="font-size:24px;">${icon}</span> <span>${text}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        function doPrestige() {
            const pendingPaws = Math.floor(Math.sqrt(state.totalPats / 1000000));
            if (pendingPaws <= 0) { alert("You need more total pats to earn Golden Paws!"); return; }
            if (confirm(`Reincarnate now for +${pendingPaws} Golden Paws?`)) {
                state.goldenPaws += pendingPaws;
                state.prestigeCount++;
                state.pats = 0;
                state.upgrades = {};
                saveGame(true);
                updateDisplay();
                showToast("Reincarnated successfully!", "🐾");
            }
        }

        function switchTab(tabId, evt) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('game-tab').style.display = 'none';
            document.getElementById('stats-tab').style.display = 'none';
            document.getElementById('prestige-tab').style.display = 'none';
            document.getElementById('settings-tab').style.display = 'none';

            document.getElementById(`${tabId}-tab`).style.display = 'grid';
            if (evt && evt.target) evt.target.classList.add('active');
        }

        function saveGame(manual = false) {
            localStorage.setItem('catClickerDeluxeSave', JSON.stringify(state));
            if (manual) showToast("Game Saved Successfully!", "💾");
        }

        function loadGame() {
            const saved = localStorage.getItem('catClickerDeluxeSave');
            if (saved) {
                try { state = { ...state, ...JSON.parse(saved) }; } catch (e) {}
            }
            renderAchievements();
            updateDisplay();
        }

        function hardReset() {
            if (confirm("Are you sure? This will delete ALL progress!")) {
                localStorage.removeItem('catClickerDeluxeSave');
                location.reload();
            }
        }

        function formatNumber(num) {
            if (num >= 1e9) return (num / 1e9).toFixed(2) + 'B';
            if (num >= 1e6) return (num / 1e6).toFixed(2) + 'M';
            if (num >= 1e3) return (num / 1e3).toFixed(2) + 'K';
            return num.toLocaleString();
        }

        window.addEventListener('DOMContentLoaded', () => { loadGame(); });
    </script>
</body>
</html>
